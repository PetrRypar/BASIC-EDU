<Window x:Class="BasicEdu.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:editor="http://icsharpcode.net/sharpdevelop/avalonedit" Title="BASIC EDU 1.0 • prototyp" Width="1200" Height="760" MinWidth="850" MinHeight="500" Closing="OnClosing">
 <DockPanel Background="#EFF3F8">
  <WrapPanel DockPanel.Dock="Top" Margin="12">
   <TextBlock Text="BASIC EDU" FontSize="23" FontWeight="Bold" Margin="0,0,24,0"/>
   <Button Content="Nový" Click="NewFile" Padding="12,5"/><Button Content="Otevřít…" Click="OpenFile" Padding="12,5" Margin="6,0"/><Button Content="Uložit" Click="SaveFile" Padding="12,5"/><Button Content="Uložit jako…" Click="SaveAs" Padding="12,5" Margin="6,0"/>
   <Button x:Name="RunButton" Content="▶ Spustit (F5)" Click="Run" Padding="15,5" Background="#BBF7D0"/>
   <Button x:Name="StepButton" Content="Krok (F8)" Click="Step" Padding="12,5" Margin="6,0,0,0"/>
   <Button x:Name="StopButton" Content="■ Zastavit (Esc)" Click="Stop" Padding="15,5" Margin="6,0" IsEnabled="False"/>
  </WrapPanel>
  <StackPanel x:Name="ExamplesPanel" DockPanel.Dock="Top" Margin="12,0,12,10">
   <WrapPanel>
    <TextBlock Text="Ukázkové programy" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <ComboBox x:Name="ExamplesList" Width="290" MaxDropDownHeight="360" DisplayMemberPath="Title" SelectionChanged="ExampleSelected" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="01–10 základy • 11–18 výpočty a rozhodování • 19–26 cykly a algoritmy • 27–30 kvízy a hry • 31 LED semafor"/>
    <Button Content="Otevřít ukázku v editoru" Click="OpenExample" Padding="12,5"/>
   </WrapPanel>
   <TextBlock x:Name="ExampleDescription" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <TextBlock x:Name="ExampleTask" TextWrapping="Wrap" Foreground="#315580" Margin="0,3,0,0"/>
  </StackPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="Připraveno" Margin="12,7"/>
  <Grid Margin="12,0,12,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
   <DockPanel><TextBlock DockPanel.Dock="Top" Text="PROGRAM • číslované řádky" Margin="0,5" FontWeight="Bold"/><editor:TextEditor x:Name="Editor" FontFamily="Consolas" FontSize="16" Background="White" Foreground="#18212F" Padding="4" WordWrap="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="Edited"/></DockPanel>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
   <DockPanel Grid.Column="2" Margin="8,0">
    <TextBlock DockPanel.Dock="Top" Text="VÝSTUP" Margin="0,5" FontWeight="Bold"/>
    <Border DockPanel.Dock="Top" Background="#DFE7F0" BorderBrush="#B7C4D4" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,7">
     <StackPanel>
      <WrapPanel>
       <StackPanel Width="100" HorizontalAlignment="Center"><Ellipse x:Name="Led1Indicator" Width="30" Height="30" Fill="Black" Stroke="#5F7084" StrokeThickness="2"/><TextBlock x:Name="Led1Label" Text="LED1 • vypnuto" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Width="100" HorizontalAlignment="Center"><Ellipse x:Name="Led2Indicator" Width="30" Height="30" Fill="Black" Stroke="#5F7084" StrokeThickness="2"/><TextBlock x:Name="Led2Label" Text="LED2 • vypnuto" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Width="100" HorizontalAlignment="Center"><Ellipse x:Name="Led3Indicator" Width="30" Height="30" Fill="Black" Stroke="#5F7084" StrokeThickness="2"/><TextBlock x:Name="Led3Label" Text="LED3 • vypnuto" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
      </WrapPanel>
      <Expander Header="Barvy LED • příklad: LED1(3)" Margin="0,6,0,0"><TextBlock x:Name="LedLegend" TextWrapping="Wrap" Margin="0,4,0,0"/></Expander>
     </StackPanel>
    </Border>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><Button DockPanel.Dock="Right" x:Name="InputButton" Content="Odeslat" Click="SubmitInput" IsEnabled="False" Padding="10,4"/><TextBox x:Name="InputBox" FontSize="16" IsEnabled="False" KeyDown="InputKeyDown"/></DockPanel>
    <RichTextBox x:Name="Output" IsReadOnly="True" FontFamily="Consolas" FontSize="16" Background="Black" Foreground="White" VerticalScrollBarVisibility="Auto"><FlowDocument PagePadding="8"><Paragraph Margin="0"/></FlowDocument></RichTextBox>
   </DockPanel>
   <Grid Grid.Column="3" Margin="12,5,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="PROMĚNNÉ" FontWeight="Bold"/>
    <DataGrid x:Name="VariablesGrid" Grid.Row="1" Margin="0,6,0,12" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto">
     <DataGrid.Columns><DataGridTextColumn Header="Název" Binding="{Binding Name}" Width="80"/><DataGridTextColumn Header="Hodnota" Binding="{Binding Value}" Width="*"/></DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="2" Text="RYCHLÁ NÁPOVĚDA" FontWeight="Bold"/>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="F8 provede jeden BASIC řádek. Žlutě je označen další řádek k provedení.&#10;F5 pokračuje bez krokování. Esc zastaví program.&#10;&#10;Proměnné se aktualizují mezi kroky a při ukončení.&#10;INPUT čeká na odpověď v poli pod výstupem.&#10;&#10;PRINT &quot;Ahoj světe!&quot;&#10;INPUT &quot;Jméno: &quot;; J$&#10;LET A = 2 + 3&#10;IF A &gt; 2 THEN 100&#10;GOTO 10&#10;FOR I = 1 TO 5&#10;NEXT I&#10;COLOR 14, 1&#10;CLS&#10;END&#10;&#10;Textové proměnné končí $. Jeden příkaz na řádek."/></ScrollViewer>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
